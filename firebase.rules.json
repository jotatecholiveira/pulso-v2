{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "transactions": {
          ".indexOn": ["date", "type"]
        },
        "planoInvestimento": {
          ".validate": "newData.hasChildren(['valorInicial', 'aporteMensal', 'criadoEm'])"
        }
      }
    },
    ".info": {
      "connected": {
        ".read": true
      }
    }
  }
}